rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidQrItem(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'url', 'type', 'isPublic', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.url is string && data.url.size() <= 5000000
        && data.type in ['video', 'file']
        && data.isPublic is bool
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Collection: qr_items
    match /qr_items/{qrId} {
      // Single-item view: Public viewer or owner
      allow get: if isValidId(qrId) && (
        resource.data.isPublic == true ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );

      // List: Strictly enforced to only list items belonging to the authenticated user
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Create: Authenticated owner
      allow create: if isValidId(qrId)
        && isSignedIn()
        && incoming().userId == request.auth.uid
        && isValidQrItem(incoming());

      // Update: Owner can update content, or public can increment view counter
      allow update: if isValidId(qrId) && (
        // Action 1: Owner updates item
        (
          isOwner(existing().userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && isValidQrItem(incoming())
        ) ||
        // Action 2: Viewer increments view counter
        (
          existing().isPublic == true
          && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt'])
          && incoming().viewsCount is number
          && incoming().viewsCount == existing().viewsCount + 1
        )
      );

      // Delete: Owner only
      allow delete: if isValidId(qrId) && isOwner(existing().userId);
    }

    // Collection: users
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create, update: if isValidId(userId) && isOwner(userId) && incoming().uid == request.auth.uid && isValidUserProfile(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Health-check / connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
